# LMS Environment Configuration

# Flask App Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-super-secret-key-in-production-lms-2026
JWT_SECRET_KEY=change-this-jwt-secret-key-for-token-signing-lms-2026
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# MySQL Database Configuration (MySQL 8+)
# Provide MySQL credentials below. If MySQL is not running locally, backend falls back to SQLite for instant testing.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=lms_database

# Or specify full connection string directly (Optional)
# DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/lms_database

# File Uploads Directory
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
